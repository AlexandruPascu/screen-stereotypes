{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stereotype label for one plot summary (codebook v1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "gender", "groups", "prejudice_theme", "slur_present", "confidence", "notes"],
  "properties": {
    "id": {"type": "string", "pattern": "^L[0-9]{5}$"},
    "gender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portrayal", "types", "counter_stereotype"],
      "properties": {
        "portrayal": {"enum": ["none", "mild", "clear"]},
        "types": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["appearance", "sexualization", "domestic_role", "damsel_victim", "emotional_irrational",
                             "romance_defined", "occupational_marking", "male_dominance_norm",
                             "incompetent_man_at_home", "other"]}
        },
        "counter_stereotype": {"type": "boolean"}
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group", "portrayal", "types", "evidence"],
        "properties": {
          "group": {"type": "string", "minLength": 1, "maxLength": 60},
          "portrayal": {"enum": ["neutral", "stereotyped", "counter_stereotyped"]},
          "types": {
            "type": "array",
            "uniqueItems": true,
            "items": {"enum": ["criminality", "terrorism_extremism", "danger_threat", "savage_primitive", "exotic_other",
                               "servile_role", "greed_money", "hypersexual", "caricature", "victim_only", "other"]}
          },
          "evidence": {"type": "string", "maxLength": 160}
        }
      }
    },
    "prejudice_theme": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "stance"],
      "properties": {
        "present": {"type": "boolean"},
        "stance": {"enum": ["critical", "neutral", "endorsing", null]}
      }
    },
    "slur_present": {"type": "boolean"},
    "confidence": {"enum": [1, 2, 3]},
    "notes": {"type": "string", "maxLength": 200}
  }
}
